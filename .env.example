AMBIENTE_PROCESSO=desenvolvimento

# Configurações de conexão com o banco de dados
DB_HOST=localhost
DB_DATABASE=''
DB_USER=''
DB_PASSWORD=''
DB_PORT=3306

# Configurações do servidor de aplicação
APP_PORT=8080
APP_HOST=localhost

#jira
JIRA_DOMAIN=stream-guard
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP
JIRA_ISSUE_TYPE=Incident
JIRA_SERVICE_DESK_ID=1
JIRA_REQUEST_TYPE_ID=1

# Data Lake
# Se vazio, tenta BUCKET_GOLD; se ambos vazios, o painel não consulta o Data Lake.
DATA_LAKE_BUCKET=
AWS_REGION=
# As credenciais da AWS são resolvidas pelo SDK (role da instância, aws configure ou variáveis AWS_*).
# Opcional: perfil do ~/.aws/credentials; se omitido, o SDK usa "default".
# AWS_PROFILE=
# Layout esperado: gold/<id_empresa>/atual/resumo_metricas.json
GOLD_PREFIX=gold/
# Fuso dos timestamps gravados no gold (padrão: -03:00)
DATA_LAKE_UTC_OFFSET=-03:00
# Tempo de cache do resumo em segundos; 0 desativa (padrão: 60)
DATA_LAKE_CACHE_SEGUNDOS=60
